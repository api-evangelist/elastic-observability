{
  "opencollection": "1.0.0",
  "info": {
    "name": "Elastic Observability (APM Server) Agent Configuration Server Info API",
    "version": "8.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Server Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Server information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}:{port}/"
          },
          "docs": "Returns build/version information for the APM Server."
        }
      ]
    }
  ],
  "bundled": true
}